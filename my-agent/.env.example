# AWS Bedrock Configuration
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_BEARER_TOKEN_BEDROCK=your_bearer_token_here

# S3 Storage
FINCORE_S3_BUCKET=fincore-ai-dev

# Environment. Leave UNSET (or anything other than "development") for
# TestFlight/production. Setting ENVIRONMENT=development enables the
# TEMP /auth/dev session-bypass endpoint used by the app's __DEV__ "Skip Sign-In".
# ENVIRONMENT=development

# Admin
FINCORE_ADMIN_KEY=your_admin_key_here

# Auth — session signing (required; generate with e.g. `openssl rand -hex 32`)
FINCORE_SESSION_SECRET=your_session_signing_secret_here

# Auth — provider identifiers (public, not secrets; must match expo-app/config.ts)
APPLE_BUNDLE_ID=one.fincore.app
GOOGLE_CLIENT_ID=336431541348-hbifi1ohb2hsomhqqe2i289nm6oehdpg.apps.googleusercontent.com
MICROSOFT_CLIENT_ID=d371e6ba-5463-4b47-a5fe-c2c87506f610
MICROSOFT_TENANT_ID=08802439-90c8-400a-901b-79fabbd75eb7

# Auth — Apple authorizationCode exchange (optional; only needed if identityToken
# is ever absent from a native Sign in with Apple response). Requires a Sign in
# with Apple key from the Apple Developer portal. Leave unset to have that path
# fail with a clear 501 instead of silently misbehaving.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Bedrock Model IDs
BEDROCK_MODEL=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_TEXT_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_IMAGE_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Langfuse Tracing
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_CHAT_PK=your_langfuse_chat_public_key
LANGFUSE_CHAT_SK=your_langfuse_chat_secret_key
LANGFUSE_CAMERA_PK=your_langfuse_camera_public_key
LANGFUSE_CAMERA_SK=your_langfuse_camera_secret_key

# RapidAPI (Product Pricing)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=uk-supermarkets-product-pricing.p.rapidapi.com
